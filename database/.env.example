# ==============================================================================
# SDR COCKPIT STARTER - VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para `database/.env` e preencha os valores reais.
# NUNCA faça commit de `database/.env`.
# ==============================================================================

# 1. Supabase (obrigatório)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_SUA_CHAVE_PUBLICAVEL
SUPABASE_SERVICE_ROLE_KEY=sb_secret_SUA_CHAVE_SECRETA
SUPABASE_PROJECT_REF=SEU_PROJETO

# Opcional: Personal Access Token do Supabase (para `python tools/provisionar.py` publicar migrações e Edge Function via CLI)
SUPABASE_ACCESS_TOKEN=

# 2. Inteligência Artificial - Google AI Studio (usado no segredo Gemini_Key da Edge Function e em testes)
GEMINI_API_KEY=
GEMINI_MODELOS=gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-2.5-flash

# 3. Operadores (Supabase Auth - provisionados por `python database/provision_operators.py`)
OPERATOR_PASSWORD=TrocarNoPrimeiroAcesso!2026
OPERATOR_OPERADOR1_EMAIL=operador1@suaempresa.com.br
OPERATOR_OPERADOR2_EMAIL=operador2@suaempresa.com.br

# 4. Deploy FTP opcional (`python tools/deploy_ftp.py`)
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=/public_html/crm
PUBLIC_URL=
