{
  "manifest_version": 3,
  "name": "P4m — SDR Cockpit Disparo & Sync",
  "version": "3.2.0",
  "description": "Automação humanizada de abordagem inicial via WhatsApp Web, fallback Gmail e sincronização bidirecional de timeline com o P4m CRM.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "P4m — SDR Cockpit",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://mail.google.com/*",
    "https://per4media.com.br/*",
    "https://vtwxjrcxpbzlbwghfdab.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "gmail_content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
