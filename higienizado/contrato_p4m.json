  "hookValidation": {
    "maxLength": 650,
    "requireTwoParagraphs": true,
    "warnSingleParagraph": false,
    "firstParagraphMax": 350,
    "forbiddenPatterns": [
      "\\b(acompanho|acompanhamos|admiro|admiramos|sou f[aã]|j[aá] vi (o )?seu|conhe[cç]o (o )?seu trabalho|sempre acompanhei)\\b"
    ],
    "forbiddenRobotPattern": "pelo que vi|encontrei [^.\\n:]{3,160}: ",
    "approvedCurrencyValues": []
  },
  "enrichment": {
    "siteUrl": "https://per4media.com.br/marketing-digital-pme/",
    "models": {},
    "signals": {},
    "questions": {},
    "modelRules": []
  }
